+#ifdef __SWITCH__
+/* SSX port diagnostic: the waits that block (the fence not yet signalled),
+ * per caller (and the caller of nouveau_screen_fence_finish when it is that):
+ * count and time, read and reset by nouveau_fence_wait_report(). */
+#define FW_SLOTS 24
+static struct { const void *from, *outer; unsigned n; int64_t ns; } fw_stat[FW_SLOTS];
+const void *nouveau_fence_wait_outer;
+static void fw_note(const void *from, int64_t ns)
+{
+   for (int i = 0; i < FW_SLOTS; i++) {
+      if (!fw_stat[i].from) {
+         fw_stat[i].from = from, fw_stat[i].outer = nouveau_fence_wait_outer;
+      }
+      if (fw_stat[i].from == from && fw_stat[i].outer == nouveau_fence_wait_outer) {
+         fw_stat[i].n++, fw_stat[i].ns += ns;
+         return;
+      }
+   }
+}
+/* one line per caller into buf: "<from> <outer> <n> <us>"; addresses as
+ * offsets from nouveau_fence_wait, to be put to names with the ELF */
+int nouveau_fence_wait_report(char *buf, int size);
+int nouveau_fence_wait_report(char *buf, int size)
+{
+   int len = 0;
+   for (int i = 0; i < FW_SLOTS && fw_stat[i].from; i++) {
+      len += snprintf(buf + len, size > len ? size - len : 0, " [%+ld %+ld: %u, %lld us]",
+                      (long)((const char *)fw_stat[i].from - (const char *)nouveau_fence_wait),
+                      fw_stat[i].outer ? (long)((const char *)fw_stat[i].outer - (const char *)nouveau_fence_wait) : 0L,
+                      fw_stat[i].n, (long long)(fw_stat[i].ns / 1000));
+      fw_stat[i].from = fw_stat[i].outer = NULL, fw_stat[i].n = 0, fw_stat[i].ns = 0;
+   }
+   return len;
+}
+#endif
