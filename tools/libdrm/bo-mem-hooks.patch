 	nvAddressSpaceUnmap(&nvdev->addr_space, bo->offset);
 	nvMapClose(&nvbo->map);
 	if (nvbo->map_addr)
-		free(nvbo->map_addr);
+		nouveau_switch_bo_mem_free(nvbo->map_addr, bo->size);
 	free(nvbo);
 }
 
