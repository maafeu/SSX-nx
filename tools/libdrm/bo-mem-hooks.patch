--- a/source/nouveau.c
+++ b/source/nouveau.c
@@ -337,6 +337,23 @@
 	return ret;
 }
 
+/* SSX-nx: a port may supply the memory behind its buffer objects (weak; the
+ * default is what this file always did). The SSX port keeps big blocks for
+ * reuse: a 1280x720 texture freed and remade at every load left a hole that
+ * memalign could not reuse, and the heap's arena grew ~4 MB a load. */
+__attribute__((weak)) void *
+nouveau_switch_bo_mem_alloc(size_t size)
+{
+	return memalign(0x1000, size);
+}
+
+__attribute__((weak)) void
+nouveau_switch_bo_mem_free(void *mem, size_t size)
+{
+	(void)size;
+	free(mem);
+}
+
 static void
 nouveau_bo_del(struct nouveau_bo *bo)
 {
